[sub_resource type="GDScript" id="GDScript_interaction_ti"]
resource_name = "interaction_manager_with_prompt"
script/source = "extends InteractionManager
## Puente que conecta InteractionManager con el HUD de interacción
## (InteractionPrompt) sin modificar ninguno de los dos scripts originales.

@export var prompt_path: NodePath

@onready var _prompt: Control = get_node_or_null(prompt_path)

func show_interaction() -> void:
	if _prompt == null:
		return
	var target := get_current_target()
	var text := \"Presiona E\"
	if target != null and target.has_method(\"get_interaction_prompt\"):
		text = target.call(\"get_interaction_prompt\")
	if _prompt.has_method(\"show_prompt\"):
		_prompt.call(\"show_prompt\", text)

func hide_interaction() -> void:
	if _prompt and _prompt.has_method(\"hide_prompt\"):
		_prompt.call(\"hide_prompt\")
"

[sub_resource type="GDScript" id="GDScript_door_bridge_ti"]
resource_name = "door_interact_bridge"
script/source = "extends StaticBody3D
## Puente mínimo: le da a la puerta un método interact() para que
## InteractionManager pueda detectarla con el RayCast3D, sin tocar door.gd.

@export var door_path: NodePath

func interact() -> void:
	var door := get_node_or_null(door_path)
	if door and door.has_method(\"try_open\"):
		door.call(\"try_open\", [])

func get_interaction_prompt() -> String:
	return \"Presiona E para abrir/cerrar la puerta\"
"

